{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "options": {
          "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
        }
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
