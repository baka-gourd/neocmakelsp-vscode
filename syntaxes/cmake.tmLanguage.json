{
  "name": "CMake",
  "scopeName": "source.cmake",
  "patterns": [
    { "name": "comment.block.cmake", "begin": "#\\[(=*)\\[", "end": "\\]\\1\\]" },
    { "name": "comment.line.number-sign.cmake", "begin": "#", "end": "$" },
    { "name": "string.quoted.other.cmake", "begin": "\\[(=*)\\[", "end": "\\]\\1\\]" },
    {
      "name": "string.quoted.double.cmake",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.cmake", "match": "\\\\." },
        { "include": "#variable" }
      ]
    },
    { "include": "#variable" },
    {
      "name": "keyword.control.cmake",
      "match": "(?i)\\b(?:if|elseif|else|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|block|endblock|return|break|continue)\\b(?=\\s*\\()"
    },
    { "name": "entity.name.function.cmake", "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()" },
    { "name": "constant.numeric.cmake", "match": "\\b[0-9]+(?:\\.[0-9]+)*\\b" },
    { "name": "constant.language.cmake", "match": "\\b(?:ON|OFF|TRUE|FALSE|YES|NO|AND|OR|NOT)\\b" }
  ],
  "repository": {
    "variable": {
      "name": "variable.other.cmake",
      "begin": "\\$(?:ENV|CACHE)?\\{",
      "end": "\\}",
      "patterns": [{ "include": "#variable" }]
    }
  }
}
